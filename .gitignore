```gitignore
# Environment variables and API keys
.env
.env.*
!.env.example

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# IDE settings
.vscode/
.idea/

# Logs
*.log

# Temporary files
tempCodeRunnerFile.py
*.tmp

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# OS files
.DS_Store
Thumbs.db
desktop.ini
```